{
  "manifest_version": 3,
  "name": "ImeAudio · Google 文档输出",
  "version": "1.1",
  "description": "把 ImeAudio 的听写结果写进被绑定的 Google 文档标签页，不影响你当前正在用的窗口。",
  "key": "",
  "permissions": ["debugger", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "点击：把当前标签页绑定为 ImeAudio 的输出目标（再点一次解除）" }
}
