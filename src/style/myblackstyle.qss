/* ==========================================================
   黑色 (Black / Dark) 主题样式表 (Qt QSS)
   自动生成 - 如需微调请直接修改对应颜色变量后重新生成
   ========================================================== */

* {
    outline: none;
}

QMainWindow, QDialog {
    background-color: rgb(53, 53, 53);
    border-color: rgb(30, 30, 30);
    color: rgb(220, 220, 220);
    font: 9pt "Microsoft YaHei";
}

QWidget {
    background-color: rgb(53, 53, 53);
    color: rgb(220, 220, 220);
    font: 9pt "Microsoft YaHei";
    selection-background-color: rgb(0, 122, 204);
    selection-color: white;
}

QWidget:disabled {
    color: rgb(120,120,120);
}

/* ---------------- 分割线 / 容器 ---------------- */
QSplitter::handle {
    background-color: rgb(30, 30, 30);
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

QFrame {
    border-color: rgb(30, 30, 30);
}

QScrollArea {
    background-color: rgb(53, 53, 53);
    border: none;
}

/* ---------------- GraphicsView / DockWidget ---------------- */
QGraphicsView {
    background-color: rgb(42, 42, 42);
    border: 1px solid rgb(30, 30, 30);
    font: 9pt "Microsoft YaHei";
}

QDockWidget {
    background-color: rgb(42, 42, 42);
    color: rgb(220, 220, 220);
    font: 9pt "Microsoft YaHei";
    titlebar-close-icon: none;
}
QDockWidget::title {
    background-color: rgb(35,35,35);
    padding: 4px 6px;
    border: 1px solid rgb(30, 30, 30);
}

/* ---------------- GroupBox ---------------- */
QGroupBox {
    background-color: rgb(53, 53, 53);
    color: rgb(220, 220, 220);
    font: 9pt "Microsoft YaHei";
    border: 1px solid rgb(30, 30, 30);
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: rgb(220, 220, 220);
}

/* ---------------- Label ---------------- */
QLabel {
    background-color: transparent;
    color: rgb(220, 220, 220);
}
QLabel:disabled {
    color: rgb(120,120,120);
}

/* ---------------- Button ---------------- */
QPushButton {
    background-color: rgb(66, 66, 66);
    color: rgb(220, 220, 220);
    font: 9pt "Microsoft YaHei";
    border: 1px solid rgb(30, 30, 30);
    border-radius: 4px;
    padding: 4px 14px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: rgb(80, 80, 80);
    border: 1px solid rgb(0, 122, 204);
}
QPushButton:pressed {
    background-color: rgb(45,45,45);
}
QPushButton:disabled {
    background-color: rgb(66, 66, 66);
    color: rgb(120,120,120);
    border: 1px solid rgb(30, 30, 30);
}
QPushButton:checked {
    background-color: rgb(0, 122, 204);
    color: white;
    border: 1px solid rgb(0, 122, 204);
}
QPushButton:default {
    border: 1px solid rgb(0, 122, 204);
}

QToolButton {
    background-color: transparent;
    color: rgb(220, 220, 220);
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px;
}
QToolButton:hover {
    background-color: rgb(80, 80, 80);
    border: 1px solid rgb(0, 122, 204);
}
QToolButton:pressed {
    background-color: rgb(45,45,45);
}
QToolButton:checked {
    background-color: rgb(0, 122, 204);
    color: white;
}

/* ---------------- LineEdit / TextEdit ---------------- */
QLineEdit {
    background-color: rgb(35, 35, 35);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
    border-radius: 3px;
    padding: 3px 6px;
    font: 9pt "Microsoft YaHei";
    selection-background-color: rgb(0, 122, 204);
    selection-color: white;
}
QLineEdit:focus {
    border: 1px solid rgb(0, 122, 204);
}
QLineEdit:disabled {
    background-color: rgb(53, 53, 53);
    color: rgb(120,120,120);
}

QTextEdit, QPlainTextEdit {
    background-color: rgb(35, 35, 35);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
    font: 9pt "Microsoft YaHei";
    selection-background-color: rgb(0, 122, 204);
    selection-color: white;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid rgb(0, 122, 204);
}

/* ---------------- ComboBox ---------------- */
QComboBox {
    background-color: rgb(35, 35, 35);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
    border-radius: 3px;
    padding: 3px 6px;
    min-height: 20px;
    font: 9pt "Microsoft YaHei";
}
QComboBox:hover {
    border: 1px solid rgb(0, 122, 204);
}
QComboBox:disabled {
    color: rgb(120,120,120);
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border: none;
    border-left: 1px solid rgb(30, 30, 30);
    width: 20px;
}
QComboBox::down-arrow {
    image: url(:/combo_down_black);
    width: 10px;
    height: 10px;
}
QComboBox::down-arrow:on {
    top: 1px;
}
QComboBox QAbstractItemView {
    background-color: rgb(35, 35, 35);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
    selection-background-color: rgb(0, 122, 204);
    selection-color: white;
    outline: none;
}

/* ---------------- CheckBox / RadioButton ---------------- */
QCheckBox, QRadioButton {
    background-color: transparent;
    color: rgb(220, 220, 220);
    spacing: 6px;
    font: 9pt "Microsoft YaHei";
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid rgb(30, 30, 30);
    background-color: rgb(35, 35, 35);
}
QCheckBox::indicator {
    border-radius: 3px;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: rgb(0, 122, 204);
    border: 1px solid rgb(0, 122, 204);
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid rgb(0, 122, 204);
}

/* ---------------- SpinBox ---------------- */
QSpinBox, QDoubleSpinBox {
    background-color: rgb(35, 35, 35);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
    border-radius: 3px;
    padding: 2px 4px;
    font: 9pt "Microsoft YaHei";
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid rgb(0, 122, 204);
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: rgb(66, 66, 66);
    border: none;
    border-left: 1px solid rgb(30, 30, 30);
    border-bottom: 1px solid rgb(30, 30, 30);
    width: 16px;
    height: 12px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: rgb(66, 66, 66);
    border: none;
    border-left: 1px solid rgb(30, 30, 30);
    width: 16px;
    height: 12px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: rgb(80, 80, 80);
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: rgb(45,45,45);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/spin_up_black);
    width: 9px;
    height: 9px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/spin_down_black);
    width: 9px;
    height: 9px;
}
QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off,
QDoubleSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:off,
QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off,
QDoubleSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:off {
    width: 9px;
    height: 9px;
}

/* ---------------- Slider ---------------- */
QSlider::groove:horizontal {
    height: 4px;
    background: rgb(30, 30, 30);
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: rgb(0, 122, 204);
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
}
QSlider::groove:vertical {
    width: 4px;
    background: rgb(30, 30, 30);
    border-radius: 2px;
}
QSlider::handle:vertical {
    background: rgb(0, 122, 204);
    height: 14px;
    margin: 0 -6px;
    border-radius: 7px;
}

/* ---------------- ProgressBar ---------------- */
QProgressBar {
    background-color: rgb(35, 35, 35);
    border: 1px solid rgb(30, 30, 30);
    border-radius: 3px;
    text-align: center;
    color: rgb(220, 220, 220);
}
QProgressBar::chunk {
    background-color: rgb(0, 122, 204);
    border-radius: 3px;
}

/* ---------------- TabWidget / TabBar ---------------- */
QTabWidget::pane {
    border: 1px solid rgb(30, 30, 30);
    background-color: rgb(53, 53, 53);
}
QTabBar::tab {
    background-color: rgb(66, 66, 66);
    color: rgb(220, 220, 220);
    padding: 6px 14px;
    border: 1px solid rgb(30, 30, 30);
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: rgb(53, 53, 53);
    border-bottom: 2px solid rgb(0, 122, 204);
}
QTabBar::tab:hover:!selected {
    background-color: rgb(80, 80, 80);
}

/* ---------------- MenuBar / Menu ---------------- */
QMenuBar {
    background-color: rgb(53, 53, 53);
    color: rgb(220, 220, 220);
    font: 9pt "Microsoft YaHei";
}
QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}
QMenuBar::item:selected {
    background-color: rgb(0, 122, 204);
    color: white;
}
QMenu {
    background-color: rgb(45, 45, 45);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
}
QMenu::item {
    padding: 5px 20px 5px 20px;
}
QMenu::item:selected {
    background-color: rgb(0, 122, 204);
    color: white;
}
QMenu::separator {
    height: 1px;
    background: rgb(30, 30, 30);
    margin: 4px 4px;
}

/* ---------------- ToolBar / StatusBar ---------------- */
QToolBar {
    background-color: rgb(42, 42, 42);
    border: none;
    spacing: 3px;
}
QStatusBar {
    background-color: rgb(42, 42, 42);
    color: rgb(220, 220, 220);
}

/* ---------------- ScrollBar ---------------- */
QScrollBar:vertical {
    background: rgb(45,45,45);
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgb(90,90,90);
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: rgb(0, 122, 204);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: rgb(45,45,45);
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: rgb(90,90,90);
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: rgb(0, 122, 204);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------------- ListWidget / ListView ---------------- */
QListWidget, QListView {
    background-color: rgb(45, 45, 45);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
    alternate-background-color: rgb(38, 38, 38);
}
QListWidget::item, QListView::item {
    height: 30px;
    padding-left: 5px;
}
QListWidget::item:selected, QListView::item:selected {
    background-color: rgb(0, 122, 204);
    color: white;
}
QListWidget::item:hover, QListView::item:hover {
    background-color: rgb(80, 80, 80);
}

/* ---------------- TreeWidget / TreeView ---------------- */
QTreeWidget, QTreeView {
    background-color: rgb(45, 45, 45);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
    alternate-background-color: rgb(38, 38, 38);
}
QTreeWidget::item, QTreeView::item {
    height: 30px;
    padding-left: 5px;
}
QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: rgb(0, 122, 204);
    color: white;
}
QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: rgb(80, 80, 80);
}
QTreeView::branch {
    background-color: transparent;
}

/* ---------------- TableWidget / TableView / HeaderView ---------------- */
QTableWidget, QTableView {
    background-color: rgb(45, 45, 45);
    color: rgb(220, 220, 220);
    border: 1px solid rgb(30, 30, 30);
    gridline-color: rgb(30, 30, 30);
    alternate-background-color: rgb(38, 38, 38);
}
QTableWidget::item, QTableView::item {
    padding: 4px;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: rgb(0, 122, 204);
    color: white;
}
QHeaderView::section {
    background-color: rgb(60, 60, 60);
    color: rgb(220, 220, 220);
    padding: 5px;
    border: 1px solid rgb(30, 30, 30);
}
QHeaderView::section:hover {
    background-color: rgb(80, 80, 80);
}

/* ---------------- ToolTip ---------------- */
QToolTip {
    background-color: rgb(30,30,30);
    color: white;
    border: 1px solid rgb(30, 30, 30);
    padding: 4px;
}


/* ===== 顶部状态卡片 ===== */
#statusCard {
    background-color: rgb(53, 53, 53);
    border: 1px solid #2a2b30;
    border-radius: 12px;
}

#cpuIconLabel {
    color: #9a9ba3;
    font-size: 13px;
}

#cpuTitleLabel {
    color: #f0f0f2;
    font-size: 13px;
    font-weight: 600;
}

#cpuSubLabel {
    color: #8a8b93;
    font-size: 12px;
}

/* ===== CUDA 后端标题区域 ===== */
#cudaSectionTitle {
    color: #f5f5f7;
    font-size: 13px;
    font-weight: 700;
}

#cudaSectionDesc {
    color: #9a9ba3;
    font-size: 12px;
}

/* ===== 分隔线 ===== */
#sectionDivider {
    color: #2a2b30;
    background-color: #2a2b30;
}

/* ===== 下载行 ===== */
#downloadTitleLabel {
    color: #f0f0f2;
    font-size: 13px;
    font-weight: 600;
}

#downloadSizeLabel {
    color: #8a8b93;
    font-size: 12px;
}

#downloadProgressBar {
    background-color: #2a2b30;
    border-radius: 3px;
}
#downloadProgressBar::chunk {
    background-color: #d9b35d;
    border-radius: 3px;
}

#downloadButton {
    background-color: #d9b35d;
    color: #1a1a1a;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
}
#downloadButton:hover {
    background-color: #e6c273;
}
#downloadButton:disabled {
    background-color: #4a4a4a;
    color: #8a8a8a;
}

#gpu_backend_widget{
    background-color: #2a2b30;
    border: 1px solid #2a2b30;
    border-radius: 12px;
}




/* ==========================================================================
   DARK THEME (深色模式)
   ========================================================================== */
QScrollArea#download_list_container {
    border: 1px solid #2c2c2e;
    background: transparent;
}
QWidget#download_list_viewport {
    background-color: rgb(35, 35, 35);
}

/* 项目卡片容器 */
#projectGroupCard {
    background-color: #212121;
    border: 1px solid #2c2c2e;
    border-radius: 12px;
}

/* 顶部标题与进度 */
#titleLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}
#overallLabel {
    color: #8e8e93;
    font-size: 12px;
}

/* 整体大进度条 */
#overallBar {
    background-color: #2c2c2e;
    border-radius: 2px;
}
#overallBar::chunk {
    background-color: #d9b35d; /* 金色，突出整体任务进度 */
    border-radius: 2px;
}

/* 分割线 */
QFrame[frameShape="HLine"] {
    background-color: #2c2c2e;
}

/* 文件行容器 */
#fileRowContainer {
    background-color: transparent;
    border-radius: 6px;
}
#fileRowContainer:hover {
    background-color: rgba(255, 255, 255, 0.05); /* 悬停微亮 */
}

/* 文件名与状态 */
#fileNameLabel {
    color: #d1d1d6;
    font-size: 12px;
}
#fileStatusLabel {
    color: #8e8e93;
    font-size: 11px;
}

/* 文件单行进度条 */
#fileProgressBar {
    background-color: #2c2c2e;
    border-radius: 3px;
}
#fileProgressBar::chunk {
    background-color: #5b8ee8; /* 蓝色，代表单个任务进度 */
    border-radius: 3px;
}





/* ==========================================================================
   NavListWidget
   ========================================================================== */
#nav_list_widget{
    background-color: #121212;
}

/* 导航列表容器 */
#navListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}

/* 选中的条目样式 (QListWidget 的 item 选中状态) */
QListWidget::item:selected {
    background-color: rgba(255, 255, 255, 0.1);
}

/* 导航条目整体 (NavListItemWidget) */
#navItemContainer {
    background-color: transparent;
    border-radius: 8px;
}
#navItemContainer:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

/* 图标与文字 */
#navItemIcon {
    color: #a1a1a6;
    font-size: 16px;
}
#navItemText {
    color: #e5e5e7;
    font-size: 10px;
}

/* 指示灯 (Indicator Dot) */
#navItemIndicator {
    border-radius: 4px;
    background-color: #3a3a3c; /* 默认灰色 */
}
#navItemIndicator[indicatorColor="yellow"] {
    background-color: #ffcc00; /* 下载中 */
}
#navItemIndicator[indicatorColor="green"] {
    background-color: #32d74b; /* 已完成 */
}

